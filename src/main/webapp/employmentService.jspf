<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.util.ArrayList" %>
<%@ page import="employmentDB.employmentDo" %>

<jsp:useBean id="employmentDao" class="employmentDB.employmentDao" />

<%
    ArrayList<employmentDo> jobs = employmentDao.getAllEmployment();
%>

<section class="jobs-section page-shell" id="jobs" aria-labelledby="jobs-title">
    <div class="section-heading">
        <div>
            <span class="eyebrow">EXPLORE OPPORTUNITIES</span>
            <h2 id="jobs-title">
                지금 확인할 수 있는 <strong>채용 공고</strong>
            </h2>
            <p>관심 있는 기업의 모집 정보를 확인해 보세요.</p>
        </div>

        <span class="job-count">
            전체 <strong><%= jobs.size() %></strong>건
        </span>
    </div>

    <% if (jobs.isEmpty()) { %>
        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">⌁</span>
            <h3>아직 등록된 공고가 없어요.</h3>
            <p>첫 채용 공고를 등록하고 새로운 기회를 연결해 보세요.</p>
            <a class="button button--primary" href="employmentRegister.jsp">
                공고 등록하기
            </a>
        </div>
    <% } else { %>
        <div class="job-grid">
            <% for (employmentDo job : jobs) { %>
                <%@ include file="employmentCard.jspf"%>
            <% } %>
        </div>
    <% } %>
</section>